<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= recipe.title %> - <%= t(lang, 'appTitle' ) %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            padding-top: 56px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        #langToggle {
            margin-left: auto;
        }

        .recipe-image {
            max-height: 300px;
            object-fit: cover;
            width: 100%;
            border-radius: 8px;
        }

        .navbar {
            background-color: #df5341;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .1);
        }

        .navbar-brand {
            color: white !important;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .recipe-card {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, .1);
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .recipe-title {
            color: #df5341;
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .recipe-meta {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .recipe-meta i {
            color: #df5341;
            margin-right: 0.25rem;
        }

        .nutrition-info {
            background-color: #e9ecef;
            border-radius: 8px;
            padding: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .nutrition-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.25rem;
        }

        .nutrition-item i {
            color: #df5341;
            margin-right: 0.25rem;
            width: 20px;
        }

        .ingredients-list,
        .instructions-list {
            padding-left: 0;
            list-style-type: none;
            counter-reset: step-counter;
        }

        .instructions-list li {
            margin-bottom: 0.5rem;
            padding: 0.5rem 0.5rem 0.5rem 2rem;
            background-color: #f8f9fa;
            border-radius: 4px;
            position: relative;
            font-size: 0.9rem;
        }

        .instructions-list li::before {
            content: counter(step-counter);
            counter-increment: step-counter;
            position: absolute;
            left: 0.25rem;
            top: 50%;
            transform: translateY(-50%);
            background-color: #df5341;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: bold;
        }

        .timer-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.2rem;
            padding: 0.15rem 0.45rem;
            margin-left: 0.35rem;
            border-radius: 999px;
            background-color: #ffe6dc;
            color: #c74836;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .timer-chip i {
            color: #df5341;
        }

        .btn-primary {
            background-color: #df5341;
            border-color: #df5341;
        }

        .btn-primary:hover {
            background-color: #c74836;
            border-color: #c74836;
        }

        .portion-controls {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            flex-wrap: wrap;
        }

        .portion-count {
            min-width: 36px;
            text-align: center;
            font-weight: 600;
            display: inline-block;
        }

        .portion-btn {
            padding: 0.2rem 0.6rem;
            line-height: 1.2;
        }

        .ingredient-line {
            display: flex;
            align-items: baseline;
            gap: 0.35rem;
            flex-wrap: wrap;
        }

        .ingredient-quantity {
            min-width: 38px;
            display: inline-block;
            font-weight: 600;
        }

        @media (max-width: 576px) {
            body {
                padding-top: 0;
            }

            .navbar {
                position: relative;
            }

            .navbar .container {
                flex-direction: column;
                align-items: center;
            }

            .container {
                padding-left: 10px;
                padding-right: 10px;
            }

            .recipe-meta .row>div {
                margin-bottom: 0.5rem;
            }

            #langToggle {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-anchor me-2"></i><span id="appTitle">
                    <%= t(lang, 'appTitle' ) %>
                </span></a>
            <button class="btn btn-outline-light" onclick="toggleLanguage()">
                <%= t(lang, 'switchLang' ) %>
            </button>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="recipe-card">
                    <h1 class="recipe-title">
                        <%= recipe.title %>
                    </h1>
                    <% const appLink = recipe.appLink || (recipe.recipeId ? `https://mobile.kptncook.com/r/${recipe.recipeId}` : null); %>
                    <% if (recipe.imageList && recipe.imageList.length> 0) { %>
                        <img src="<%= recipe.imageList.find(img => img.type === 'cover')?.url || recipe.imageList[0].url %>"
                            alt="<%= recipe.title %>" class="recipe-image mb-4">
                        <% if (appLink) { %>
                        <div class="d-block d-md-none mb-3">
                            <a class="btn btn-success w-100" href="<%= appLink %>" target="_blank" rel="noopener">
                                <i class="fas fa-mobile-alt me-2"></i>
                                <%= t(lang, 'openInApp' ) %>
                            </a>
                        </div>
                        <% } %>
                        <% } %>
                            <div class="recipe-meta">
                                <div class="row">
                                    <div class="col-sm-4">
                                        <div class="portion-controls">
                                            <i class="fas fa-utensils"></i>
                                            <strong>
                                                <%= t(lang, 'portions' ) %>:
                                            </strong>
                                            <div class="btn-group ms-1" role="group">
                                                <button class="btn btn-sm btn-outline-primary portion-btn"
                                                    onclick="changePortions(-1)">-</button>
                                                <span id="portionCount" class="portion-count">
                                                    <%= recipe.portionCount || recipe.yield || recipe.servings ||
                                                        recipe.portions || recipe.fixedPortionCount || 1 %>
                                                </span>
                                                <button class="btn btn-sm btn-outline-primary portion-btn"
                                                    onclick="changePortions(1)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <i class="fas fa-clock"></i> <strong>
                                            <%= t(lang, 'prepTime' ) %>:
                                        </strong>
                                        <%= (recipe.displayPrepTime ?? recipe.preparationTime ?? t(lang, 'notSpecified'
                                            )) %>
                                            <%= t(lang, 'minutes' ) %>
                                    </div>
                                    <div class="col-sm-4">
                                        <i class="fas fa-fire"></i> <strong>
                                            <%= t(lang, 'cookTime' ) %>:
                                        </strong>
                                        <%= (recipe.displayCookTime ?? recipe.cookingTime ?? t(lang, 'notSpecified' ))
                                            %>
                                            <%= t(lang, 'minutes' ) %>
                                    </div>
                                </div>
                                <% if (recipe.displayTotalTime || recipe.displayTemperature) { %>
                                    <div class="row mt-2">
                                        <% if (recipe.displayTotalTime) { %>
                                            <div class="col-sm-4">
                                                <i class="fas fa-hourglass-half"></i> <strong>
                                                    <%= t(lang, 'totalTime' ) %>:
                                                </strong>
                                                <%= recipe.displayTotalTime %>
                                                    <%= t(lang, 'minutes' ) %>
                                            </div>
                                            <% } %>
                                                <% if (recipe.displayTemperature) { %>
                                                    <div class="col-sm-4">
                                                        <i class="fas fa-thermometer-half"></i> <strong>
                                                            <%= t(lang, 'temperature' ) %>:
                                                        </strong>
                                                        <%= recipe.displayTemperature %> °C
                                                    </div>
                                                    <% } %>
                                    </div>
                                    <% } %>
                            </div>
                            <% if (recipe.recipeNutrition) { %>
                                <div class="nutrition-info">
                                    <h5 class="mb-3">
                                        <%= t(lang, 'nutritionInfo' ) %>
                                    </h5>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="nutrition-item">
                                                <i class="fas fa-fire-alt"></i>
                                                <span><strong>
                                                        <%= t(lang, 'calories' ) %>:
                                                    </strong>
                                                    <%= recipe.recipeNutrition.calories %> kcal
                                                </span>
                                            </div>
                                            <div class="nutrition-item">
                                                <i class="fas fa-drumstick-bite"></i>
                                                <span><strong>
                                                        <%= t(lang, 'protein' ) %>:
                                                    </strong>
                                                    <%= recipe.recipeNutrition.protein %> g
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="nutrition-item">
                                                <i class="fas fa-cheese"></i>
                                                <span><strong>
                                                        <%= t(lang, 'fat' ) %>:
                                                    </strong>
                                                    <%= recipe.recipeNutrition.fat %> g
                                                </span>
                                            </div>
                                            <div class="nutrition-item">
                                                <i class="fas fa-bread-slice"></i>
                                                <span><strong>
                                                        <%= t(lang, 'carbs' ) %>:
                                                    </strong>
                                                    <%= recipe.recipeNutrition.carbohydrate %> g
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                                    <h5 class="mt-4 mb-3">
                                        <%= t(lang, 'ingredients' ) %>
                                    </h5>
                                    <ul class="ingredients-list">
                                        <% recipe.ingredients.forEach(ingredient=> { %>
                                            <li>
                                                <div class="ingredient-line">
                                                    <i class="fas fa-check-circle text-success me-1"></i>
                                                    <span class="ingredient-quantity"
                                                        data-per-serving="<%= ingredient.perServingQuantity ?? '' %>">
                                                        <%= ingredient.quantity || '' %>
                                                    </span>
                                                    <span class="ingredient-measure">
                                                        <%= ingredient.measure || '' %>
                                                    </span>
                                                    <span class="ingredient-title">
                                                        <%= ingredient.ingredient.title %>
                                                    </span>
                                                </div>
                                            </li>
                                            <% }); %>
                                    </ul>
                                    <% function escapeHtml(str) {
                                        return String(str || '')
                                            .replace(/&/g, '&amp;')
                                            .replace(/</g, '&lt;')
                                            .replace(/>/g, '&gt;');
                                    }

                                    function renderStepTitleWithTimers(step) {
                                        const safeTitle = escapeHtml(step.title || '');
                                        if (step.renderedTimers && step.renderedTimers.length) {
                                            const chip = `<span class="timer-chip"><i class="fas fa-stopwatch"></i>${step.renderedTimers.join(', ')} ${t(lang, 'minutes')}</span>`;
                                            if (safeTitle.includes('&lt;timer&gt;')) {
                                                return safeTitle.replace('&lt;timer&gt;', chip);
                                            }
                                            return `${safeTitle} ${chip}`;
                                        }
                                        return safeTitle;
                                    } %>

                                    <h5 class="mt-4 mb-3">
                                        <%= t(lang, 'instructions' ) %>
                                    </h5>
                                    <ol class="instructions-list">
                                        <% recipe.steps.forEach(step=> { %>
                                            <li>
                                                <%- renderStepTitleWithTimers(step) %>
                                            </li>
                                            <% }); %>
                                    </ol>
                                    <div class="d-grid gap-2 mt-4">
                                        <% if (appLink) { %>
                                        <a class="btn btn-success d-none d-md-inline-block" href="<%= appLink %>"
                                            target="_blank" rel="noopener">
                                            <i class="fas fa-mobile-alt me-2"></i>
                                            <%= t(lang, 'openInApp' ) %>
                                        </a>
                                        <% } %>
                                        <button class="btn btn-primary" onclick="copyDirectLink()">
                                            <i class="fas fa-link me-2"></i>
                                            <%= t(lang, 'copyLink' ) %>
                                        </button>
                                        <button class="btn btn-secondary" onclick="copyAsMarkdown()">
                                            <i class="fas fa-file-alt me-2"></i>
                                            <%= t(lang, 'copyMarkdown' ) %>
                                        </button>
                                    </div>
                                    <div id="copyMessage" class="alert alert-success mt-3" style="display: none;"
                                        role="alert"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const recipe = <%- JSON.stringify(recipe) %>;
        let currentPortions = recipe.portionCount || recipe.yield || recipe.servings || recipe.portions || recipe.fixedPortionCount || 1;

        function formatQuantityClient(quantity) {
            if (quantity === null || quantity === undefined || isNaN(quantity)) {
                return '';
            }
            const rounded = Math.round((quantity + Number.EPSILON) * 100) / 100;
            return Number.isInteger(rounded) ? Math.round(rounded).toString() : rounded.toString();
        }

        function toggleLanguage() {
            const currentLang = document.documentElement.lang;
            const newLang = currentLang === 'de' ? 'en' : 'de';
            window.location.href = window.location.pathname + '?lang=' + newLang;
        }

        function copyDirectLink() {
            const directLink = window.location.href;
            navigator.clipboard.writeText(directLink).then(() => {
                showCopyMessage('<%= t(lang, "linkCopied") %>');
            });
        }

        function updateIngredientQuantities() {
            const portionCountEl = document.getElementById('portionCount');
            if (portionCountEl) {
                portionCountEl.textContent = currentPortions;
            }

            document.querySelectorAll('.ingredient-quantity').forEach(el => {
                const perServing = parseFloat(el.dataset.perServing);
                if (isNaN(perServing)) {
                    return;
                }
                const total = perServing * currentPortions;
                el.textContent = formatQuantityClient(total);
            });

            recipe.portionCount = currentPortions;
            recipe.ingredients = recipe.ingredients.map(ing => {
                if (typeof ing.perServingQuantity === 'number') {
                    return {
                        ...ing,
                        quantity: formatQuantityClient(ing.perServingQuantity * currentPortions)
                    };
                }
                return ing;
            });
        }

        function changePortions(delta) {
            const next = Math.max(1, currentPortions + delta);
            if (next === currentPortions) return;
            currentPortions = next;
            updateIngredientQuantities();
        }

        document.addEventListener('DOMContentLoaded', () => {
            updateIngredientQuantities();
        });

        function copyAsMarkdown() {
            let markdown = `# ${recipe.title}\n\n`;

            if (recipe.imageList && recipe.imageList.length > 0) {
                markdown += `![${recipe.title}](${recipe.imageList[0].url})\n\n`;
            }

            const portions = currentPortions || recipe.portionCount || recipe.yield || recipe.servings || recipe.portions || recipe.fixedPortionCount || '<%= t(lang, "notSpecified") %>';
            const prepTime = (recipe.displayPrepTime ?? recipe.preparationTime);
            const cookTime = (recipe.displayCookTime ?? recipe.cookingTime);

            markdown += `**<%= t(lang, "portions") %>:** ${portions}\n`;
            markdown += `**<%= t(lang, "prepTime") %>:** ${(prepTime ?? '<%= t(lang, "notSpecified") %>')} <%= t(lang, "minutes") %>\n`;
            markdown += `**<%= t(lang, "cookTime") %>:** ${(cookTime ?? '<%= t(lang, "notSpecified") %>')} <%= t(lang, "minutes") %>\n\n`;

            if (recipe.recipeNutrition) {
                markdown += `## <%= t(lang, "nutritionInfo") %>\n`;
                markdown += `- <%= t(lang, "calories") %>: ${recipe.recipeNutrition.calories} kcal\n`;
                markdown += `- <%= t(lang, "protein") %>: ${recipe.recipeNutrition.protein} g\n`;
                markdown += `- <%= t(lang, "fat") %>: ${recipe.recipeNutrition.fat} g\n`;
                markdown += `- <%= t(lang, "carbs") %>: ${recipe.recipeNutrition.carbohydrate} g\n\n`;
            }

            markdown += `## <%= t(lang, "ingredients") %>\n`;
            recipe.ingredients.forEach(ingredient => {
                const perServing = typeof ingredient.perServingQuantity === 'number' ? ingredient.perServingQuantity : null;
                const quantity = perServing !== null ? formatQuantityClient(perServing * currentPortions) : (ingredient.quantity || '');
                const measure = ingredient.measure || '';
                const title = ingredient.ingredient.title;
                const quantityText = quantity ? `${quantity} ` : '';
                const measureText = measure ? `${measure} ` : '';
                markdown += `- ${quantityText}${measureText}${title}\n`;
            });

            markdown += `\n## <%= t(lang, "instructions") %>\n`;
            recipe.steps.forEach((step, index) => {
                markdown += `${index + 1}. ${step.title}\n`;
            });

            navigator.clipboard.writeText(markdown).then(() => {
                showCopyMessage('<%= t(lang, "markdownCopied") %>');
            });
        }

        function showCopyMessage(message) {
            const copyMessage = document.getElementById('copyMessage');
            copyMessage.textContent = message;
            copyMessage.style.display = 'block';
            setTimeout(() => {
                copyMessage.style.display = 'none';
            }, 3000);
        }

        // Expose for inline handlers
        window.changePortions = changePortions;
        window.copyDirectLink = copyDirectLink;
        window.copyAsMarkdown = copyAsMarkdown;
        window.toggleLanguage = toggleLanguage;
    </script>
</body>

</html>